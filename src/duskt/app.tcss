Screen {
    background: #0a0a0a;
    color: #ededed;
}

Header {
    background: #0a0a0a;
    color: #888888;
    height: 1;
}

Footer {
    background: #0a0a0a;
    color: #888888;
    height: 1;
}

Footer .footer--key,
Footer .footer--description {
    background: #00c853;
    color: #0a0a0a;
    text-style: bold;
}

#app-container {
    width: 100%;
    height: 1fr;
    padding: 0;
}

#topbar {
    width: 100%;
    height: 11;
    align: left top;
}

#logo {
    background: transparent;
    color: #00c853;
    text-style: bold;
    width: 70;
    height: 11;
    text-align: left;
}

#tagline {
    color: #888888;
    width: 1fr;
    margin: 0;
}

.panel {
    width: 100%;
    padding: 0;
    margin: 0;
}

.prompt {
    color: #888888;
    text-style: bold;
    margin-bottom: 0;
}

Input {
    width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    margin-bottom: 0;
}

Input:focus {
    border: none;
}

.muted {
    color: #888888;
    margin: 0;
}

#title-display {
    color: #ffffff;
    text-style: bold;
}

#playlist-panel {
    margin: 0;
}

VideoSelector {
    height: auto;
    max-height: 16;
    margin: 0;
    padding: 0;
    background: transparent;
}

VideoSelector:focus {
    border: tall #00c853;
}

.error {
    color: #ee0000;
    height: auto;
}

.status {
    color: #00c853;
    height: auto;
}

#progress {
    margin: 0;
}

.options {
    color: #ededed;
    margin: 0;
}

FormatSelector {
    height: auto;
    max-height: 12;
    margin: 0;
    padding: 0;
    background: transparent;
}

FormatSelector:focus {
    border: tall #00c853;
}

VideoSelector .selection-list--button-highlighted,
FormatSelector .selection-list--button-highlighted,
VideoSelector .selection-list--button-selected-highlighted,
FormatSelector .selection-list--button-selected-highlighted {
    background: transparent;
    color: #00c853;
    text-style: bold;
}

VideoSelector .selection-list--button-selected,
FormatSelector .selection-list--button-selected {
    color: #00c853;
    text-style: bold;
}

.hidden {
    display: none;
}
